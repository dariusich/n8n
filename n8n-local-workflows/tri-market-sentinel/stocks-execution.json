      {
        "id": "a98f4e17-b383-49f2-b797-133b01b712b2",
        "name": "Validate execution request",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -300,
          120
        ],
        "parameters": {
          "jsCode": "return $input.all().map((item) => {\n  const trade = item.json;\n  const errors = [];\n  if (trade.market !== 'stocks') errors.push('wrong_market');\n  if (!trade.execution_allowed) errors.push('execution_not_allowed');\n  if (!trade.order?.asset) errors.push('missing_asset');\n  if (!['buy', 'sell'].includes(trade.order?.side)) errors.push('invalid_side');\n  if (!trade.order?.stop_loss_required || !trade.order?.take_profit_required) errors.push('missing_required_risk_controls');\n  return { json: { ...trade, execution_validation: { passed: errors.length === 0, errors } } };\n});"
        }
      },
      {
        "id": "9edd48d2-ea28-4ffa-a0ac-70511f21d9e1",
        "name": "Validation passed?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          20,
          120
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "strict",
              "version": 2
            },
            "conditions": [
              {
                "id": "3dc067f9-f274-4466-bc00-012aebcae2bd",
                "leftValue": "={{ $json.execution_validation.passed }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        }
      },
      {
        "id": "1dbcc50e-d30d-439c-a5bb-f3d8b474bfc4",
        "name": "Paper execution fill",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          360,
          40
        ],
        "parameters": {
          "jsCode": "return $input.all().map((item) => {\n  const trade = item.json;\n  return {\n    json: {\n      ...trade,\n      execution_result: {\n        status: trade.execution_mode === 'paper' ? 'paper_filled' : 'ready_for_live_api',\n        venue: 'Broker API',\n        endpoint: 'Alpaca / IBKR / Tradier order endpoint',\n        executed_at: new Date().toISOString(),\n        order_id: `paper_stocks_${Date.now()}`,\n        message: trade.execution_mode === 'paper'\n          ? 'Paper trade recorded. Replace this node with real broker/exchange execution after testing.'\n          : 'Live mode requested. Add real authenticated HTTP request node before enabling.',\n      },\n    },\n  };\n});"
        }
