        "id": "ecbf20ca-8489-4876-b14e-bae5b2db5584",
        "name": "Validate execution request",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -300,
          120
        ],
        "parameters": {
          "jsCode": "return $input.all().map((item) => {\n  const trade = item.json;\n  const errors = [];\n  if (trade.market !== 'forex') errors.push('wrong_market');\n  if (!trade.execution_allowed) errors.push('execution_not_allowed');\n  if (!trade.order?.asset) errors.push('missing_asset');\n  if (!['buy', 'sell'].includes(trade.order?.side)) errors.push('invalid_side');\n  if (!trade.order?.stop_loss_required || !trade.order?.take_profit_required) errors.push('missing_required_risk_controls');\n  return { json: { ...trade, execution_validation: { passed: errors.length === 0, errors } } };\n});"
        }
      },
      {
        "id": "312bda7f-3bc3-48a5-bbb0-cc169bc418b0",
        "name": "Validation passed?",
        "type": "n8n-nodes-base.if",
