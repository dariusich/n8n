        "id": "70a0d42a-df3a-4f4c-9053-9a46f223a77b",
        "name": "Validate execution request",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -300,
          120
        ],
        "parameters": {
          "jsCode": "return $input.all().map((item) => {\n  const trade = item.json;\n  const errors = [];\n  if (trade.market !== 'crypto') errors.push('wrong_market');\n  if (!trade.execution_allowed) errors.push('execution_not_allowed');\n  if (!trade.order?.asset) errors.push('missing_asset');\n  if (!['buy', 'sell'].includes(trade.order?.side)) errors.push('invalid_side');\n  if (!trade.order?.stop_loss_required || !trade.order?.take_profit_required) errors.push('missing_required_risk_controls');\n  return { json: { ...trade, execution_validation: { passed: errors.length === 0, errors } } };\n});"
        }
      },
      {
        "id": "51c70eec-9a52-4d76-8d05-a7978ff870c0",
        "name": "Validation passed?",
        "type": "n8n-nodes-base.if",
